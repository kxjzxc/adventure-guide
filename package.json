{
  "name": "adventure-guide",
  "version": "0.1.0",
  "description": "Adventure Guide — compile your Obsidian Vault into a static world-exploration website",
  "type": "commonjs",
  "main": "lib/index.js",
  "bin": {
    "ag": "bin/ag.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/index.ts",
    "ag": "ts-node src/cli/index.ts",
    "g": "ts-node src/cli/index.ts generate",
    "s": "ts-node src/cli/index.ts server",
    "clean": "ts-node src/cli/index.ts clean",
    "new": "ts-node src/cli/index.ts new",
    "init": "ts-node src/cli/index.ts init",
    "lint": "oxlint src/"
  },
  "keywords": [
    "obsidian",
    "static-site-generator",
    "adventure",
    "world",
    "knowledge"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.79.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
